{# templates/purchase.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}
  Purchase Item
{% endblock %}

{% block styles %}
  <link rel="stylesheet" href="{{ asset('css/purchase.css') }}">
{% endblock %}

{% block body %}
<div class="container purchase-page">
  <h2>Purchase {{ item.title }}</h2>
  <p>Price: ${{ item.price }}</p>

  {# 表单提交到处理上传的路由，需在后端对应 #}
  <form id="purchase-form"
        action="{{ path('purchase_item_submit', {'itemId': item.id}) }}"
        method="post"
        enctype="multipart/form-data">
    <div class="form-group">
      <label for="proof">Upload the Certification:</label>
      <input type="file" id="proof" name="proof" accept="image/*" required>
    </div>

    <div class="form-group">
      <label for="message">And leave your lovely message:</label>
      <textarea id="message" name="message" rows="3"></textarea>
    </div>

    <button type="submit" class="btn">Confirm</button>
  </form>
</div>

{# 如果提交成功后，你想直接在该页面显示弹窗，可以用一个条件 #}
{% if success is defined and success == true %}
  <div class="modal" id="purchase-success-modal" style="display:block;">
    <div class="modal-content">
      <p>Congratulations. You bought a nice present!</p>
      <button class="btn"
              onclick="window.location='{{ path('shared_wishlist', {'id': item.ownerId}) }}'">
        Accept
      </button>
    </div>
  </div>
{% endif %}

{% endblock %}
