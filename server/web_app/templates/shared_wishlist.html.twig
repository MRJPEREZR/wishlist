{# templates/shared_wishlist.html.twig #}
{% extends 'base.html.twig' %}

{% block styles %}
<style>
body {
  background-color: #f0f4f8;
}

.wishlist-container {
  max-width: 1200px;
  margin: 40px auto;
  padding: 30px;
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  background-color: #ffffff;
  box-shadow: 0 4px 8px rgba(0,0,0,0.1);
  border-radius: 12px;
}

.wishlist-container h1 {
  text-align: center;
  margin-bottom: 40px;
  font-size: 32px;
  color: #333;
  font-weight: bold;
}

.sort-container {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 25px;
}

#sortOrder {
  padding: 8px 15px;
  border-radius: 6px;
  border: 1px solid #ddd;
  background-color: #fff;
  cursor: pointer;
}

.items-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 20px;
  align-items: start;
}

.item {
  background-color: #ffffff;
  border: none;
  border-radius: 12px;
  box-shadow: 0 4px 8px rgba(0,0,0,.1);
  padding: 20px;
  position: relative;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.item:hover {
  transform: translateY(-6px);
  box-shadow: 0 6px 12px rgba(0,0,0,0.15);
}

.item-title {
  font-size: 20px;
  font-weight: bold;
  color: #222;
}

.item-price {
  font-size: 18px;
  color: #888;
}

.item button {
  padding: 8px 16px;
  background-color: #17a2b8;
  color: #fff;
  font-size: 14px;
  border: none;
  border-radius: 6px;
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.item button:hover {
  background-color: #138496;
}

.tooltip {
  visibility: hidden;
  opacity: 0;
  position: absolute;
  left: 50%;
  top: -50px;
  transform: translateX(-50%);
  background-color: rgba(51, 51, 51, 0.95);
  color: #fff;
  padding: 10px 12px;
  border-radius: 6px;
  font-size: 13px;
  transition: opacity 0.3s ease;
}

.item[data-is-bought="true"]:hover .tooltip {
  visibility: visible;
  opacity: 1;
}

#purchaseModal {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0,0,0,0.5);
  justify-content: center;
  align-items: center;
  z-index: 100;
}

#purchaseModal form {
  background-color: #fff;
  padding: 25px;
  border-radius: 12px;
  box-shadow: 0 6px 12px rgba(0,0,0,0.2);
  width: 400px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

#purchaseModal button {
  margin-top: 10px;
}
</style>
{% endblock %}

{% block body %}
<div class="wishlist-container">
  <h1>{{ wishList.title }}'s WishList</h1>

  <div class="sort-container">
    <form id="sortForm" method="get" action="{{ app.request.pathinfo }}">
      <label for="sortOrder">Sort by:</label>
      <select name="sortOrder" id="sortOrder" onchange="this.form.submit()">
        <option value="asc" {% if app.request.query.get('sortOrder', 'asc') == 'asc' %}selected{% endif %}>Price: Low to High</option>
        <option value="desc" {% if app.request.query.get('sortOrder', 'asc') == 'desc' %}selected{% endif %}>Price: High to Low</option>
      </select>
    </form>
  </div>

  <div class="items-list">
    {% for item in items %}
      <div class="item" data-is-bought="{{ item.is_bought ? 'true' : 'false' }}">
        <div class="item-content">
          <div class="item-title">{{ item.title }}</div>
          <div>
            <span class="item-price">${{ item.price }}</span>
            {% if item.is_bought %}
              <span class="status purchased">Purchased✔️</span>
            {% endif %}
          </div>
          {% if item.is_bought and item.purchaseMessage is not empty %}
            <div class="tooltip">
              {{ item.purchaseMessage }}<br>
              {{ item.purchaseDate ? '(Purchased at ' ~ item.purchaseDate ~ ')' : '' }}
            </div>
          {% elseif not item.is_bought %}
            <button onclick="openPurchaseModal({{ item.id }}, '{{ item.purchaseUrl }}')">Buy</button>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<div id="purchaseModal" style="display:none;opacity:0;"></div>
{% endblock %}

{% block javascripts %}
<script>
function openPurchaseModal(itemId, purchaseUrl) {
  document.getElementById('purchaseModal').innerHTML = `<form method="post" action="{{ path('item_purchase') }}" enctype="multipart/form-data">
    <input type="hidden" name="itemId" value="${itemId}">
    <label>Upload Certification:</label>
    <input type="file" name="certificate" required>
    <label>Leave your lovely message:</label>
    <textarea name="message" placeholder="Your message..."></textarea>
    <button type="submit">Confirm</button>
    <button type="button" onclick="closePurchaseModal()">Cancel</button>
  </form>`;

  const modal = document.getElementById('purchaseModal');
  modal.style.display = 'flex';
  setTimeout(() => modal.style.opacity = 1, 50);
  window.open(purchaseUrl, '_blank');
}

function closePurchaseModal() {
  const modal = document.getElementById('purchaseModal');
  modal.style.opacity = 0;
  setTimeout(() => modal.style.display = 'none', 200);
}
</script>
{% endblock %}
